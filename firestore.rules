rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolios/{portfolioId} {
      allow read, write: if true;

      match /holdings/{holdingId} {
        allow read, write: if true;
      }

      match /backups/{backupId} {
        allow read, write: if true;
      }
    }
  }
}
