rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /portfolios/{portfolioId} {
      allow read, write: if isValidId(portfolioId);

      match /holdings/{holdingId} {
        allow read, write: if isValidId(portfolioId) && isValidId(holdingId);
      }

      match /backups/{backupId} {
        allow read, write: if isValidId(portfolioId) && isValidId(backupId);
      }
    }

    // Secure helper to prevent ID poisoning and invalid paths
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
  }
}
